# tvs-stack settings — copy to .env and edit
#
# Required: absolute paths to your tvs-be and tvs-fe worktrees.
# Defaults assume sibling directories of tvs-stack.
TVS_BE_PATH=../tvs-be
TVS_FE_PATH=../tvs-fe

# Host port mappings. Defaults match what the app's own .env files expect.
BACKEND_PORT=8020
FRONTEND_PORT=3000
FRONTEND_UI_PORT=3001
MYSQL_PORT=3306
REDIS_PORT=6379
FLOWER_PORT=5555

# What URL the browser-side FE should hit for the API.
# Leave unset to default to http://localhost:${BACKEND_PORT}.
# Set to https://api.thefinstore.com to mimic `npm run start:livebe`.
# API_URL=

# Your Okta SSO id, used by `./start.sh --seed` to link the seeded app user.
# Find it in the admin of any nonprod env (your tvsci user's "Sso id"), or
# decode the `uid` claim of your bearer token. Lets you run a bare `--seed`.
# SEED_OKTA_ID=
